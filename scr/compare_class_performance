from pathlib import Path

import pandas as pd
import matplotlib.pyplot as plt

from sklearn.compose import ColumnTransformer
from sklearn.ensemble import RandomForestClassifier
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import (
    classification_report,
    ConfusionMatrixDisplay,
    confusion_matrix,
)
from sklearn.model_selection import (
    train_test_split,
    StratifiedKFold,
    cross_val_predict,
)
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import OneHotEncoder, StandardScaler


# ---------------------------------------------------------
# Project folders
# ---------------------------------------------------------

PROJECT_ROOT = Path(__file__).resolve().parents[1]

DATA_PATH = (
    PROJECT_ROOT
    / "data"
    / "raw"
    / "student_outcomes.csv"
)

FIGURES_DIR = PROJECT_ROOT / "outputs" / "figures"
OUTPUT_DIR = PROJECT_ROOT / "outputs"

FIGURES_DIR.mkdir(parents=True, exist_ok=True)
OUTPUT_DIR.mkdir(parents=True, exist_ok=True)


# ---------------------------------------------------------
# Load dataset
# ---------------------------------------------------------

df = pd.read_csv(DATA_PATH)


# ---------------------------------------------------------
# Remove second-semester information
# ---------------------------------------------------------

second_semester_features = [
    "Curricular units 2nd sem (credited)",
    "Curricular units 2nd sem (enrolled)",
    "Curricular units 2nd sem (evaluations)",
    "Curricular units 2nd sem (approved)",
    "Curricular units 2nd sem (grade)",
    "Curricular units 2nd sem (without evaluations)",
]

df_model = df.drop(columns=second_semester_features)

X = df_model.drop(columns="Target")
y = df_model["Target"]


# ---------------------------------------------------------
# Same train/test split
# ---------------------------------------------------------

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=42,
    stratify=y,
)


# ---------------------------------------------------------
# Feature groups
# ---------------------------------------------------------

categorical_features = [
    "Marital Status",
    "Application mode",
    "Course",
    "Previous qualification",
    "Nacionality",
    "Mother's qualification",
    "Father's qualification",
    "Mother's occupation",
    "Father's occupation",
]

binary_features = [
    "Daytime/evening attendance",
    "Displaced",
    "Educational special needs",
    "Debtor",
    "Tuition fees up to date",
    "Gender",
    "Scholarship holder",
    "International",
]

numerical_features = [
    "Application order",
    "Previous qualification (grade)",
    "Admission grade",
    "Age at enrollment",
    "Curricular units 1st sem (credited)",
    "Curricular units 1st sem (enrolled)",
    "Curricular units 1st sem (evaluations)",
    "Curricular units 1st sem (approved)",
    "Curricular units 1st sem (grade)",
    "Curricular units 1st sem (without evaluations)",
    "Unemployment rate",
    "Inflation rate",
    "GDP",
]


# ---------------------------------------------------------
# Logistic Regression preprocessing
# ---------------------------------------------------------

logistic_preprocessor = ColumnTransformer(
    transformers=[
        (
            "categorical",
            OneHotEncoder(handle_unknown="ignore"),
            categorical_features,
        ),
        (
            "numerical",
            StandardScaler(),
            numerical_features,
        ),
        (
            "binary",
            "passthrough",
            binary_features,
        ),
    ]
)


logistic_model = Pipeline(
    steps=[
        ("preprocessor", logistic_preprocessor),
        (
            "classifier",
            LogisticRegression(
                max_iter=2000,
                random_state=42,
            ),
        ),
    ]
)


# ---------------------------------------------------------
# Random Forest preprocessing
# ---------------------------------------------------------

forest_preprocessor = ColumnTransformer(
    transformers=[
        (
            "categorical",
            OneHotEncoder(handle_unknown="ignore"),
            categorical_features,
        ),
        (
            "numerical",
            "passthrough",
            numerical_features,
        ),
        (
            "binary",
            "passthrough",
            binary_features,
        ),
    ]
)


random_forest_model = Pipeline(
    steps=[
        ("preprocessor", forest_preprocessor),
        (
            "classifier",
            RandomForestClassifier(
                n_estimators=300,
                max_depth=None,
                min_samples_leaf=1,
                random_state=42,
                n_jobs=-1,
            ),
        ),
    ]
)


# ---------------------------------------------------------
# Cross-validation
# ---------------------------------------------------------

cv = StratifiedKFold(
    n_splits=5,
    shuffle=True,
    random_state=42,
)

labels = [
    "Dropout",
    "Enrolled",
    "Graduate",
]


# ---------------------------------------------------------
# Out-of-fold predictions
# ---------------------------------------------------------

print("Generating Logistic Regression predictions...")

logistic_predictions = cross_val_predict(
    logistic_model,
    X_train,
    y_train,
    cv=cv,
    n_jobs=-1,
)

print("Generating Random Forest predictions...")

forest_predictions = cross_val_predict(
    random_forest_model,
    X_train,
    y_train,
    cv=cv,
    n_jobs=-1,
)


# ---------------------------------------------------------
# Classification reports
# ---------------------------------------------------------

print("\nLOGISTIC REGRESSION")
print("-------------------")

print(
    classification_report(
        y_train,
        logistic_predictions,
        labels=labels,
        digits=3,
    )
)


print("\nRANDOM FOREST")
print("-------------")

print(
    classification_report(
        y_train,
        forest_predictions,
        labels=labels,
        digits=3,
    )
)


# ---------------------------------------------------------
# Logistic Regression confusion matrix
# ---------------------------------------------------------

logistic_cm = confusion_matrix(
    y_train,
    logistic_predictions,
    labels=labels,
)

logistic_cm_df = pd.DataFrame(
    logistic_cm,
    index=labels,
    columns=labels,
)

logistic_cm_df.to_csv(
    OUTPUT_DIR / "logistic_cv_confusion_matrix.csv"
)


ConfusionMatrixDisplay(
    confusion_matrix=logistic_cm,
    display_labels=labels,
).plot()

plt.title(
    "Logistic Regression\n"
    "Cross-Validated Confusion Matrix"
)

plt.tight_layout()

plt.savefig(
    FIGURES_DIR
    / "logistic_cv_confusion_matrix.png",
    dpi=300,
)

plt.show()


# ---------------------------------------------------------
# Random Forest confusion matrix
# ---------------------------------------------------------

forest_cm = confusion_matrix(
    y_train,
    forest_predictions,
    labels=labels,
)

forest_cm_df = pd.DataFrame(
    forest_cm,
    index=labels,
    columns=labels,
)

forest_cm_df.to_csv(
    OUTPUT_DIR / "random_forest_cv_confusion_matrix.csv"
)


ConfusionMatrixDisplay(
    confusion_matrix=forest_cm,
    display_labels=labels,
).plot()

plt.title(
    "Random Forest\n"
    "Cross-Validated Confusion Matrix"
)

plt.tight_layout()

plt.savefig(
    FIGURES_DIR
    / "random_forest_cv_confusion_matrix.png",
    dpi=300,
)

plt.show()